# Copy to .env.local and fill in your credentials.
# These variables are server-only — the browser never sees them.

AI_PROVIDER=openai
AI_API_KEY=sk-xxx
# AI_MODEL=                   # optional — uses the provider default if omitted
# AI_BASE_URL=                # optional — for Moonshot .cn endpoint, etc.

# ── Model reference ──────────────────────────────────────────────────────────
# OpenAI:    gpt-5.5 | gpt-4.1 | gpt-4o-2024-11-20 | o4-mini
# Claude:    claude-opus-4-7 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
# Gemini:    gemini-2.5-pro | gemini-2.5-flash
# Groq:      llama-3.3-70b-versatile
# Moonshot:  kimi-k2-turbo-preview
# DeepSeek:  deepseek-chat
# ─────────────────────────────────────────────────────────────────────────────
