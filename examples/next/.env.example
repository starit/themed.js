# Copy to .env.local and fill in your credentials.
# These variables are server-only — the browser never sees them.

AI_PROVIDER=openai
AI_API_KEY=sk-xxx
# AI_MODEL=                   # optional — uses the provider default if omitted
# AI_BASE_URL=                # optional — for Moonshot .cn endpoint, etc.

# ── Model reference ──────────────────────────────────────────────────────────
# OpenAI:    gpt-5.6-luna | gpt-5.6-terra | gpt-5.6-sol
# Claude:    claude-sonnet-5 | claude-opus-5 | claude-haiku-4-5
# Gemini:    gemini-3.6-flash | gemini-3.5-flash | gemini-3.5-flash-lite
# Groq:      openai/gpt-oss-120b | openai/gpt-oss-20b
# Moonshot:  kimi-k3 | kimi-k2.6 | kimi-k2.7-code
# DeepSeek:  deepseek-v4-flash | deepseek-v4-pro
# ─────────────────────────────────────────────────────────────────────────────
