2:T863,:root {
  --themed-color-primary: #6366f1;
  --themed-color-secondary: #8b5cf6;
  --themed-color-accent: #f59e0b;
  --themed-color-background: #ffffff;
  --themed-color-surface: #f8fafc;
  --themed-color-error: #ef4444;
  --themed-color-warning: #f59e0b;
  --themed-color-success: #22c55e;
  --themed-color-info: #3b82f6;
  --themed-color-text-primary: #1f2937;
  --themed-color-text-secondary: #6b7280;
  --themed-color-text-disabled: #9ca3af;
  --themed-color-text-inverse: #ffffff;
  --themed-color-border: #e5e7eb;
  --themed-color-border-light: #f3f4f6;
  --themed-color-border-dark: #d1d5db;
  --themed-font-family-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --themed-font-family-serif: Georgia, Cambria, "Times New Roman", Times, serif;
  --themed-font-family-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  --themed-font-size-xs: 0.75rem;
  --themed-font-size-sm: 0.875rem;
  --themed-font-size-base: 1rem;
  --themed-font-size-lg: 1.125rem;
  --themed-font-size-xl: 1.25rem;
  --themed-font-size-2xl: 1.5rem;
  --themed-font-size-3xl: 1.875rem;
  --themed-font-weight-light: 300;
  --themed-font-weight-normal: 400;
  --themed-font-weight-medium: 500;
  --themed-font-weight-semibold: 600;
  --themed-font-weight-bold: 700;
  --themed-line-height-tight: 1.25;
  --themed-line-height-normal: 1.5;
  --themed-line-height-relaxed: 1.75;
  --themed-spacing-none: 0;
  --themed-spacing-xs: 0.25rem;
  --themed-spacing-sm: 0.5rem;
  --themed-spacing-md: 0.75rem;
  --themed-spacing-lg: 1rem;
  --themed-spacing-xl: 1.5rem;
  --themed-spacing-2xl: 2rem;
  --themed-radius-none: 0;
  --themed-radius-sm: 0.25rem;
  --themed-radius-md: 0.5rem;
  --themed-radius-lg: 0.75rem;
  --themed-radius-full: 9999px;
  --themed-shadow-none: none;
  --themed-shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --themed-shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  --themed-shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  --themed-transition-fast: 150ms;
  --themed-transition-normal: 250ms;
  --themed-transition-slow: 400ms;
